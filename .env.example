# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://b2b:b2b_dev_password@localhost:5432/b2b_dev

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (NextAuth / API JWT) ─────────────────────────────────
AUTH_SECRET=change_me_32_chars_minimum_random_string
NEXTAUTH_URL=http://localhost:3000

# ── API ───────────────────────────────────────────────────────
API_URL=http://localhost:3001
API_JWT_SECRET=change_me_api_jwt_secret
API_PORT=3001

# ── S3 / MinIO ────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=b2b-dev
S3_REGION=us-east-1
# Set to true for local MinIO, false for AWS S3
S3_FORCE_PATH_STYLE=true

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

