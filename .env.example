# PostgreSQL
POSTGRES_USER=b2b
POSTGRES_PASSWORD=b2b_dev_password
POSTGRES_DB=b2b_dev
DATABASE_URL=postgresql://b2b:b2b_dev_password@postgres:5432/b2b_dev

# Redis
REDIS_URL=redis://redis:6379

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=b2b-dev
S3_FORCE_PATH_STYLE=true

# Auth & Security
JWT_SECRET=dev_jwt_secret_minimum_32_characters_change_in_production!!
API_JWT_SECRET=dev_api_jwt_secret_minimum_32_chars_change_prod!!
AUTH_SECRET=dev_auth_secret_minimum_32_chars_change_in_production!!!
AUTH_NEXTAUTH_SECRET=dev_nextauth_secret_minimum_32_chars_change_prod!!!

# URLs
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://b2b-web-1:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# App Settings
NODE_ENV=development
AUTH_TRUST_HOST=true
