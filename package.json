{
  "name": "b2b-trade",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-env.js",
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/db && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=packages/shared && npm run typecheck --workspace=packages/db && npm run typecheck --workspace=apps/api && npm run typecheck --workspace=apps/web",
    "lint": "eslint .",
    "test": "npm run test --workspace=packages/shared",
    "test:api": "node tests/api.test.mjs",
    "test:uat": "node tests/uat.test.mjs",
    "test:all": "npm run test && npm run test:api",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:studio": "npm run studio --workspace=packages/db"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.18",
    "concurrently": "^9.1.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.4"
  },
  "overrides": {
    "@types/express-serve-static-core": "^4.19.6"
  },
  "dependencies": {
    "bcrypt": "^6.0.0"
  }
}
